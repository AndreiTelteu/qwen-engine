# Local coding agent: start llama-hip yourself before launching agent-evals.
AGENT_PROVIDER_ID=llama-hip
AGENT_BASE_URL=http://127.0.0.1:8080/v1
AGENT_API_KEY=local
AGENT_MODEL=local-model

# Independent OpenAI-compatible judge. Keep the real key only in .env.
JUDGE_PROVIDER_ID=external-judge
JUDGE_BASE_URL=https://example.invalid/v1
JUDGE_API_KEY=replace-me
JUDGE_MODEL=replace-me
